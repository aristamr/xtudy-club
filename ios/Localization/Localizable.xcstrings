          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis per %lld giorni, poi %@ al mese. Annulla quando vuoi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis por %lld dias, depois %@ por mês. Cancele quando quiser."
          }
        }
      }
    },
