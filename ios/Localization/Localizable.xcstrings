    "Ninety years is an illustration, not a prediction. Assumes 8 hours of sleep. Squares show equivalent time, not specific weeks.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neunzig Jahre sind eine Veranschaulichung, keine Vorhersage. Annahme: 8 Stunden Schlaf. Die Quadrate zeigen gleichwertige Zeit, keine bestimmten Wochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noventa años es una ilustración, no una predicción. Supone 8 horas de sueño. Los cuadros muestran tiempo equivalente, no semanas concretas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre-vingt-dix ans est une illustration, pas une prédiction. Base : 8 heures de sommeil. Les carrés montrent un temps équivalent, pas des semaines précises."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Novant’anni sono un’illustrazione, non una previsione. Si assumono 8 ore di sonno. I quadrati mostrano tempo equivalente, non settimane specifiche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Noventa anos é uma ilustração, não uma previsão. Considera 8 horas de sono. Os quadrados mostram tempo equivalente, não semanas específicas."
          }
        }
      }
    },
    "No more endless short videos.": {
