    "%lld weeks lived, %lld equivalent to sleep, %lld equivalent to scrolling and %lld left for everything else.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Wochen gelebt, %lld entsprechen Schlaf, %lld entsprechen Scrollen und %lld bleiben für alles andere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld semanas vividas, %lld equivalentes a dormir, %lld equivalentes a hacer scroll y %lld para todo lo demás."
