    "For privacy, iOS doesn't tell us which app is which, so all the apps you chose are unlocked.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Datenschutzgründen verrät iOS nicht, welche App welche ist, daher sind alle ausgewählten Apps entsperrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por privacidad, iOS no nos dice qué app es cuál, así que todas las apps que elegiste están desbloqueadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidentialité oblige, iOS ne nous dit pas quelle app est laquelle : toutes les apps choisies sont déverrouillées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per privacy, iOS non ci dice quale app è quale, quindi tutte le app che hai scelto sono sbloccate."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por privacidade, o iOS não nos diz qual app é qual, então todos os apps que você escolheu estão desbloqueados."
          }
        }
      }
    },
    "Free for %lld days, then %@ per month. Cancel anytime.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Tage gratis, danach %@ pro Monat. Jederzeit kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis durante %lld días, luego %@ al mes. Cancela cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
