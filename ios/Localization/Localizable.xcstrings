    "Presente never asks for or stores your passwords. You sign in on the official websites and the session stays on this iPhone. No accounts, no analytics, no ads.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Presente fragt nie nach deinen Passwörtern und speichert sie nicht. Du meldest dich auf den offiziellen Websites an, die Sitzung bleibt auf diesem iPhone. Keine Konten, keine Analysen, keine Werbung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presente nunca pide ni guarda tus contraseñas. Inicias sesión en los sitios oficiales y la sesión se queda en este iPhone. Sin cuentas, sin analíticas, sin anuncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presente ne demande ni ne stocke jamais vos mots de passe. Vous vous connectez sur les sites officiels et la session reste sur cet iPhone. Pas de compte, pas d’analyse, pas de pub."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Presente non chiede né salva mai le tue password. Accedi dai siti ufficiali e la sessione resta su questo iPhone. Niente account, niente analisi, niente pubblicità."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Presente nunca pede nem guarda suas senhas. Você entra nos sites oficiais e a sessão fica neste iPhone. Sem contas, sem análises, sem anúncios."
          }
        }
      }
    },
