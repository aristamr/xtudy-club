            "value": "%@ en un solo pago"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en une fois"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ una tantum"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uma única vez"
          }
        }
      }
    },
    "%@ once. No subscription.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ einmalig. Kein Abo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en un solo pago. Sin suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en une fois. Sans abonnement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ una sola volta. Nessun abbonamento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uma única vez. Sem assinatura."
          }
        }
      }
    },
    "%@ one-time payment, charged to your Apple Account when you confirm. No subscription; nothing renews.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmalzahlung von %@, wird bei Bestätigung über deinen Apple Account abgerechnet. Kein Abo; nichts verlängert sich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pago único de %@, cargado a tu cuenta de Apple al confirmar. Sin suscripción; no se renueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paiement unique de %@, débité sur votre compte Apple lors de la confirmation. Aucun abonnement ; rien ne se renouvelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento unico di %@, addebitato sul tuo Account Apple alla conferma. Nessun abbonamento; nulla si rinnova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento único de %@, cobrado na sua Conta Apple ao confirmar. Sem assinatura; nada é renovado."
          }
        }
      }
    },
    "%@ per month, charged to your Apple Account when you confirm. Renews automatically unless cancelled at least 24 hours before the end of the period. Manage or cancel anytime in Settings › your name › Subscriptions.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pro Monat, wird bei Bestätigung über deinen Apple Account abgerechnet. Verlängert sich automatisch, wenn du nicht mindestens 24 Stunden vor Ende des Zeitraums kündigst. Verwalten oder kündigen jederzeit unter Einstellungen › dein Name › Abonnements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al mes, cargado a tu cuenta de Apple al confirmar. Se renueva automáticamente salvo que lo canceles al menos 24 horas antes del final del periodo. Gestiona o cancela cuando quieras en Ajustes › tu nombre › Suscripciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ par mois, débité sur votre compte Apple lors de la confirmation. Renouvellement automatique sauf résiliation au moins 24 heures avant la fin de la période. Gérez ou résiliez à tout moment dans Réglages › votre nom › Abonnements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al mese, addebitati sul tuo Account Apple alla conferma. Si rinnova automaticamente se non viene annullato almeno 24 ore prima della fine del periodo. Gestisci o annulla quando vuoi in Impostazioni › il tuo nome › Abbonamenti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ por mês, cobrado na sua Conta Apple ao confirmar. Renova automaticamente, a menos que seja cancelado pelo menos 24 horas antes do fim do período. Gerencie ou cancele quando quiser em Ajustes › seu nome › Assinaturas."
          }
        }
      }
    },
    "%@ per month. Renews automatically. Cancel anytime.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pro Monat. Verlängert sich automatisch. Jederzeit kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al mes. Se renueva automáticamente. Cancela cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ par mois. Renouvellement automatique. Résiliable à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al mese. Si rinnova automaticamente. Disdici quando vuoi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ por mês. Renova automaticamente. Cancele quando quiser."
          }
        }
      }
    },
